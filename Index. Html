<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AVIATOR PRO HAITI</title>
<style>
body {
  margin: 0;
  background: #10131d;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}
header {
  background: #bd2525;
  padding: 25px 10px;
  font-size: 25px;
  font-weight: bold;
}
main {
  padding: 25px;
}
.card {
  background: #202738;
  padding: 20px;
  border-radius: 12px;
  margin: 15px auto;
  max-width: 400px;
}
input, button {
  padding: 13px;
  width: 90%;
  margin: 8px;
  border-radius: 7px;
  border: none;
  font-size: 16px;
}
button {
  background: #bd2525;
  color: white;
  font-weight: bold;
}
#resultats {
  color: #35d68a;
  overflow-wrap: anywhere;
}
</style>
</head>
<body>

<header>✈ AVIATOR PRO HAITI</header>

<main>
<h2>Analyseur Aviator</h2>
<p>Analyse statistique des résultats passés</p>

<div class="card">
<h3>Ajouter un multiplicateur</h3>
<input id="nombre" type="number"
step="0.01" min="1"
placeholder="Exemple : 2.50">
<button onclick="ajouter()">Ajouter</button>
</div>

<div class="card">
<h3>Statistiques</h3>
<p>Nombre de résultats : <span id="total">0</span></p>
<p>Moyenne : <span id="moyenne">0</span></p>
<p>Derniers résultats :</p>
<p id="resultats">Aucun résultat</p>
</div>

<p>Les statistiques ne prédisent pas les prochains résultats.</p>
</main>

<script>
let donnees = [];

function ajouter() {
  let valeur = Number(document.getElementById("nombre").value);

  if (!Number.isFinite(valeur) || valeur < 1) {
    alert("Entrez un multiplicateur valide.");
    return;
  }

  donnees.push(valeur);

  let somme = donnees.reduce((a,b) => a+b, 0);
  let moyenne = somme / donnees.length;

  document.getElementById("total").textContent =
    donnees.length;

  document.getElementById("moyenne").textContent =
    moyenne.toFixed(2) + "x";

  document.getElementById("resultats").textContent =
    donnees.slice(-10).reverse().map(x => x + "x").join(" | ");

  document.getElementById("nombre").value = "";
}
</script>

</body>
</html>
